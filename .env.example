# ───────────── Needed to start (copy this file to .env) ─────────────
NODE_ENV=development
PORT=5001

# PostgreSQL 15 or newer (docker-compose.dev.yml starts 16 with these values)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=visionguard

# Redis (docker-compose.dev.yml starts 7)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT. Two DIFFERENT long random strings. Make each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=change-me-refresh-0123456789abcdef0123456789abcdef
# Access token life in seconds. Production: 900 (15 minutes).
# For the defense day 3600 is comfortable, so no token runs out while you are explaining.
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL_DAYS=30

# Where the Next.js app runs (CORS and links in emails)
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://visionguard.example.com
# PUBLIC_API_URL=http://localhost:5001      # used inside signed media links

# ───────────── Optional: the server runs without all of these ─────────────

# Email (verification codes, password reset, invitations).
# Without MAILER_HOST every mail is printed in the server log, and in development
# the API also returns the code as "devCode", so Postman needs no mailbox.
# MAILER_HOST=smtp.gmail.com
# MAILER_PORT=587
# MAILER_SECURE=false
# MAILER_USER=you@gmail.com
# MAILER_PASSWORD=your-16-letter-app-password
# MAILER_FROM="VisionGuard <you@gmail.com>"
# EXPOSE_DEV_CODES=true        # default: true unless NODE_ENV=production

# Telegram alerts. Create a bot with @BotFather, then set its webhook to
#   <PUBLIC_API_URL>/v1/webhooks/telegram/<TELEGRAM_WEBHOOK_SECRET>
# Without a token, Telegram deliveries are recorded as "failed: not configured".
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=VisionGuardBot
TELEGRAM_WEBHOOK_SECRET=dev-telegram-secret

# Browser push. Make a key pair once with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Phone calls: "mock" needs no account (Postman plays the phone).
VOICE_PROVIDER=mock

# Payments: the sandbox gateway is played by Postman with this shared secret.
PAYMENT_WEBHOOK_SECRET=dev-payment-secret

# Customer media (snapshots, video). A private folder, never served publicly.
STORAGE_DIR=storage
MEDIA_TOKEN_SECRET=change-me-media-0123456789abcdef

# Staff accounts created by "pnpm seed" (only used the first time)
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_SUPPORT_PASSWORD=Support@12345
